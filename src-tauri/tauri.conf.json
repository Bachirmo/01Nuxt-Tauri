{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning Notes",
  "version": "0.1.0",
  "identifier": "com.example.learningnotes",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Learning Notes",
        "width": 900,
        "height": 700,
        "minWidth": 420,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
